rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Daily Calendar Logs Collection
    match /calendar_logs/{logId} {
      allow read, write: if true;
    }

    // Projects / Work Orders Collection
    match /projects/{projectId} {
      allow read, write: if true;
    }

    // Hardware Assets Collection (Scannable QR asset tags & specs)
    match /hardware_assets/{assetId} {
      allow read, write: if true;
    }

    // System Metadata
    match /system/{docId} {
      allow read, write: if true;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}

